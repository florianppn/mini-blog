# ==============================================================================
# Mini-Blog — Variables d'Environnement & Secrets (.env.example)
# ==============================================================================
# Copiez ce fichier vers .env :
#   cp .env.example .env
# Ne commitez JAMAIS le fichier .env sur un dépôt public !
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base de Données PostgreSQL
# ------------------------------------------------------------------------------
POSTGRES_DB=miniblog
POSTGRES_USER=miniblog
POSTGRES_PASSWORD=miniblog_password
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 2. Sécurité & Jeton JWT (JJWT)
# ------------------------------------------------------------------------------
# Clé secrète HMAC-SHA (minimum 256 bits / 32 octets recommandés).
# Pour générer une clé aléatoire forte en hexadécimal : openssl rand -hex 32
APP_JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# Durée de validité du JWT en millisecondes (86400000 ms = 24 heures)
APP_JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# 3. Amorçage du Compte Administrateur Initial
# ------------------------------------------------------------------------------
# Ce compte est automatiquement créé au démarrage du backend s'il n'existe pas déjà.
APP_ADMIN_EMAIL=admin@miniblog.com
APP_ADMIN_PASSWORD=adminPassword123!

# ------------------------------------------------------------------------------
# 4. Ports d'Exposition Docker (optionnel)
# ------------------------------------------------------------------------------
FRONTEND_PORT=4200
BACKEND_PORT=8080
